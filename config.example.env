# Copy this file to secrets/config.env and fill in the mailbox you want.
# Submissions are encrypted before they are saved or emailed.
# The website never puts client details in the email subject.

INTAKE_EMAIL=tranquil2754@hotmail.com

# Outlook / Hotmail. Leave SMTP_USER blank to keep submissions
# only in secrets/inbox (still encrypted) until mail is ready.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. If empty, the server uses secrets/staff-access-code.txt.
STAFF_ACCESS_CODE=

# 127.0.0.1 keeps the site on this computer. Use 0.0.0.0 on a server.
HOST=127.0.0.1
PORT=8787
